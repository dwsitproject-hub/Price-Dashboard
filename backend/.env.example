# AASTAR backend configuration. Copy to backend/.env (local) or /etc/aastar/backend.env (servers, 0600 root).
# In SIT/UAT/PROD fill secrets from Alibaba Cloud KMS Secrets Manager — never commit real values.

APP_ENV=local                                   # local | sit | uat | prod
APP_BASE_URL=http://localhost:5181              # public origin (https://aastar.kpndomain.com in prod)
APP_ALLOWED_ORIGINS=http://localhost:5181       # CSRF Origin allow-list, comma-separated
APP_RELEASE=dev                                 # git short SHA, set by CI
LOG_LEVEL=INFO

# PostgreSQL 18 — runtime role (least privilege) and migration/owner role
DATABASE_URL=postgresql+psycopg://aastar_app:CHANGE_ME@127.0.0.1:5544/aastar
MIGRATION_DATABASE_URL=postgresql+psycopg://aastar_owner:CHANGE_ME@127.0.0.1:5544/aastar
# Cloud: ...@pgm-xxxx.pg.rds.aliyuncs.com:5432/aastar?sslmode=verify-full&sslrootcert=/etc/aastar/rds-ca.pem

# Generate with: python -m app.cli gen-keys
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

# Authentication
AUTH_LOCAL_ENABLED=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=                          # first admin, created once if no admin exists
BOOTSTRAP_ADMIN_PASSWORD=                       # must meet the policy; forced change at first sign-in
BOOTSTRAP_ADMIN_NAME=AASTAR Administrator

# DWS Downstream Hub SSO (strict OIDC: code + PKCE, JWKS-verified ID token)
SSO_ENABLED=false
HUB_ISSUER=http://localhost:4000                # https://dwshub.kpndomain.com in prod
HUB_CLIENT_ID=aastar-local
HUB_REDIRECT_URI=http://localhost:5181/api/auth/sso/callback
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=viewer

# LSEG DataScope Select — leave empty for demo mode (synthetic data)
LSEG_USERNAME=
LSEG_PASSWORD=
LSEG_LOOKBACK_DAYS=7
LSEG_RIC_CHUNK=100

# Pipeline schedule
PIPELINE_CRON=0 8 * * mon-fri
PIPELINE_TZ=Asia/Jakarta
