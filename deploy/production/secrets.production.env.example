# /opt/aastar-price/secrets.production.env on the BE server 172.28.80.51 (guide §7). chmod 600, filled with
# nano, never committed, a copy kept in the team password vault. No quotes around values.
# release.sh refuses to run while any FILL_ value is left.

# ── ApsaraDB RDS for PostgreSQL 18 (guide §3). Passwords from §3 are alphanumeric, so no percent-encoding
#    is needed; any other password must have # @ : / ? % percent-encoded. sslmode=require needs SSL on the
#    instance (§3 step 2); if the instance's owner keeps SSL off, use sslmode=prefer in both lines ──
DATABASE_URL=postgresql+psycopg://aastar_app:FILL_APP_DB_PASSWORD@FILL_PROD_RDS_HOST:5432/aastar?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://aastar_owner:FILL_OWNER_DB_PASSWORD@FILL_PROD_RDS_HOST:5432/aastar?sslmode=require

# ── Keys, NEW for production (never staging's) - guide §7 generates and writes both.
#    APP_ENCRYPTION_KEY protects the LSEG token and the Google key in the database: losing it means
#    entering the Google key again, so keep it in the vault ──
APP_SECRET_KEY=FILL_FROM_GEN_KEYS
APP_ENCRYPTION_KEY=FILL_FROM_GEN_KEYS

# ── LSEG DataScope Select (production account) ──
LSEG_USERNAME=FILL_LSEG_USERNAME
LSEG_PASSWORD=FILL_LSEG_PASSWORD

# ── Claude API key for production. Leave EMPTY (ANTHROPIC_API_KEY=) to keep AI, News and Calendar off ──
ANTHROPIC_API_KEY=FILL_ANTHROPIC_API_KEY

# ── First administrator: only used when the database has NO active administrator. Production starts from
#    the staging copy, which brings its administrators, so leave both empty unless guide §15 says otherwise ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=AASTAR Administrator
