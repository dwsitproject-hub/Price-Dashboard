# /opt/aastar-price/copy-db.env - ONLY for the one-time staging copy (guide §6). chmod 600, filled with nano,
# deleted right after the copy. Both sign in as aastar_owner. libpq URLs (postgresql://, NOT
# postgresql+psycopg://), no quotes; percent-encode passwords that contain # @ : / ? or %.
# sslmode: staging as in its .env.backend (prefer), production as in secrets.production.env.
SOURCE_URL=postgresql://aastar_owner:FILL_STAGING_OWNER_PASSWORD@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/aastar?sslmode=prefer
TARGET_URL=postgresql://aastar_owner:FILL_PROD_OWNER_PASSWORD@FILL_PROD_RDS_HOST:5432/aastar?sslmode=require
