# /opt/aastar-price/production.env on the BE server 172.28.80.51 - the backend's settings (no secrets here;
# those go in secrets.production.env). Copy from the checkout, review, then run release.sh be (guide §7).
# One KEY=value per line, comments on their own lines, no quotes around values.

# ── App ──
APP_ENV=prod
# The address users open (AR-04, accepted: plain HTTP on the private network). With a name or HTTPS later,
# change these three and HUB_REDIRECT_URI together (guide §11).
APP_BASE_URL=http://172.28.80.50:3170
APP_ALLOWED_ORIGINS=http://172.28.80.50:3170
LOG_LEVEL=INFO
# Production never shows synthetic prices: without LSEG credentials the pipeline run fails instead.
ALLOW_DEMO_DATA=false

# ── Proxy and capacity ──
# Only the FE server's nginx may report the visitor's address (audit log, sign-in rate limits).
FORWARDED_ALLOW_IPS=172.28.80.50
# 2 API workers x (4 + 2 overflow) + the worker's 6 = 18 connections, under aastar_app's limit of 40.
WEB_CONCURRENCY=2
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2

# ── Sign-in ──
# Password sign-in stays on as the break-glass path next to Hub SSO.
AUTH_LOCAL_ENABLED=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# ── DWS Hub SSO, PRODUCTION Hub (guide §4). HUB_ISSUER = "issuer" of its discovery document, exactly ──
SSO_ENABLED=true
HUB_ISSUER=https://dwshub.kpndomain.com
HUB_CLIENT_ID=aastar-price
# Byte-exact as registered in the Hub (scheme, port, no trailing slash).
HUB_REDIRECT_URI=http://172.28.80.50:3170/api/auth/sso/callback
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=viewer

# ── LSEG pipeline (credentials in secrets.production.env) ──
PIPELINE_CRON=0 8 * * mon-fri
PIPELINE_TZ=Asia/Jakarta

# ── Claude API: AI narrative, News extraction, event calendar (key in secrets.production.env) ──
# Exact model id - a typo here ("claude-sonet-...") is reported as a rejected key.
CLAUDE_MODEL=claude-opus-5-5
CFTC_HISTORY_YEARS=3

# ── Google Sheet sources. The service-account key for the private sheets is pasted under
#    Admin -> Sheet sources (stored encrypted in the database); leave the file setting empty ──
SHEETS_CRON=30 8 * * mon-fri
GOOGLE_SERVICE_ACCOUNT_FILE=
