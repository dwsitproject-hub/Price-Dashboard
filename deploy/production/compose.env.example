# /opt/aastar-price/.env on EACH production server - read by Docker Compose itself (not by the app).
# Copy, then set AASTAR_PRICE_SUBNET to the line "suggested subnet for aastar-price_net" printed by
# preflight.sh on THAT server (guide §1, §5).
AASTAR_PRICE_SUBNET=FILL_FROM_PREFLIGHT

# Only if the preflight reported a port taken: use the free port it printed, everywhere guide §1 lists it.
# AASTAR_PRICE_API_BIND=172.28.80.51:4170        # BE server
# AASTAR_PRICE_WEB_BIND=172.28.80.50:3170        # FE server
# AASTAR_PRICE_API_UPSTREAM=172.28.80.51:4170    # FE server: where its nginx sends /api
