# /opt/aastar-price/fe-build.env on the FE server 172.28.80.50 - build arguments of the frontend image (guide §8).
# Baked into the page at build time: a change needs release.sh fe again. The SDK key is publishable
# (visible in the page), not a secret. One KEY=value per line, no quotes.

# DWS Hub SDK from the PRODUCTION Hub: Hub Admin -> Applications -> AASTAR Price Dashboard -> SDK.
# Never staging's key.
VITE_HUB_SDK_URL=https://dwshub.kpndomain.com/api/sdk/v1/hub-sdk.js
VITE_HUB_SDK_KEY=FILL_DWSK_KEY
