# Local Docker stack settings. Copy to deploy/docker/.env (git-ignored) and fill every empty value.
# Keys: run `python -m app.cli gen-keys` in backend/ (or any Fernet/base64 generator).
GIT_SHA=docker
WEB_PORT=5190
DB_PORT=5545

OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

BOOTSTRAP_ADMIN_EMAIL=admin@aastar.local
BOOTSTRAP_ADMIN_PASSWORD=          # ≥12 chars, 3 of 4 classes

# Optional integrations
SSO_ENABLED=false
HUB_ISSUER=http://host.docker.internal:4000
HUB_CLIENT_ID=aastar-docker
VITE_HUB_SDK_URL=
VITE_HUB_SDK_KEY=
LSEG_USERNAME=
LSEG_PASSWORD=
# Claude API — AI narrative, News extraction, event Calendar (empty = those features stay off)
ANTHROPIC_API_KEY=
