# AASTAR Price Dashboard — STAGING frontend settings (Server 1, 172.28.92.56).
# Copy to deploy/staging/.env.frontend and fill every <…>. Put comments on their own lines.

# ── Host port (free on 172.28.92.56; 3150 astar-erp and 3160 ecr-web are taken) ──
WEB_BIND_IP=0.0.0.0
WEB_PORT=3170

# ── Backend API on Server 2 (private IP + API_PORT from .env.backend) ──
API_UPSTREAM=172.28.92.57:4170

# ── DWS Hub (guide §7–§8). HUB_ORIGIN = scheme://host:port of the staging Hub, allowed in the CSP ──
HUB_ORIGIN=http://172.28.92.56:3010

# ── Hub SDK, from the staging Hub: Admin → Applications → AASTAR → SDK. Baked in at build time ──
VITE_HUB_SDK_URL=http://172.28.92.56:3010/api/sdk/v1/hub-sdk.js
VITE_HUB_SDK_KEY=<dwsk_… staging key>
