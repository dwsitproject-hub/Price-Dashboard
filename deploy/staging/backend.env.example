# AASTAR Price Dashboard — STAGING backend settings (Server 2, 172.28.92.57).
# Copy to deploy/staging/.env.backend, fill every <…>, then: chmod 600 deploy/staging/.env.backend
# Read by docker compose (port binding) and passed to the api, worker and migrate containers.
# Put comments on their own lines; URL-encode special characters in the DB passwords (@ → %40, # → %23 …).

# ── Host port (free on 172.28.92.57; 4150 astar-erp-backend and 4160 ecr-api are taken) ──
API_BIND_IP=172.28.92.57
API_PORT=4170

# ── App ──
APP_ENV=sit
APP_BASE_URL=http://172.28.92.56:3170
APP_ALLOWED_ORIGINS=http://172.28.92.56:3170
LOG_LEVEL=INFO
# Trust X-Forwarded-For only from the frontend server's Nginx (real client IP for audit and rate limits)
FORWARDED_ALLOW_IPS=172.28.92.56
# 2 API workers x (4 + 5 overflow) + worker 9 = 36 connections, under aastar_app's limit of 40
WEB_CONCURRENCY=2
DB_POOL_SIZE=4

# ── ApsaraDB RDS for PostgreSQL 18 (guide §4). Use sslmode=require once SSL is on for the instance ──
DATABASE_URL=postgresql+psycopg://aastar_app:<APP_DB_PASSWORD>@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/aastar?sslmode=prefer
MIGRATION_DATABASE_URL=postgresql+psycopg://aastar_owner:<OWNER_DB_PASSWORD>@pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com:5432/aastar?sslmode=prefer

# ── Keys: docker run --rm aastar-backend:<sha> python -m app.cli gen-keys ──
APP_SECRET_KEY=<generated>
APP_ENCRYPTION_KEY=<generated>

# ── First admin (created once; break-glass password sign-in next to Hub SSO) ──
AUTH_LOCAL_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=<admin email>
BOOTSTRAP_ADMIN_PASSWORD=<12+ chars, 3 of 4 character classes>
BOOTSTRAP_ADMIN_NAME=AASTAR Administrator

# ── DWS Hub SSO (guide §7). HUB_ISSUER must equal "issuer" in the staging Hub's discovery document ──
SSO_ENABLED=false
HUB_ISSUER=http://172.28.92.56:3010
HUB_CLIENT_ID=aastar-staging
HUB_REDIRECT_URI=http://172.28.92.56:3170/api/auth/sso/callback
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=viewer

# ── LSEG DataScope Select — leave empty for demo mode (synthetic data) ──
LSEG_USERNAME=
LSEG_PASSWORD=

# ── Pipeline ──
PIPELINE_CRON=0 8 * * mon-fri
PIPELINE_TZ=Asia/Jakarta

# ── Claude API: AI narrative, News extraction, event Calendar (guide §16). Empty = those features stay off ──
# Outbound HTTPS from 172.28.92.57 to api.anthropic.com and www.cftc.gov is required (rules N-8, N-9).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CFTC_HISTORY_YEARS=3

# ── Google Sheet sources (guide §17). Outbound HTTPS to docs.google.com, sheets.googleapis.com and
#    oauth2.googleapis.com is required (rule N-10). The service-account key for the private sheets is pasted
#    under Admin → Sheet sources (stored encrypted); GOOGLE_SERVICE_ACCOUNT_FILE is only for a mounted key file.
SHEETS_CRON=30 8 * * mon-fri
GOOGLE_SERVICE_ACCOUNT_FILE=
