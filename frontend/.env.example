# Frontend build-time settings (Vite). Copy to frontend/.env.local, or set in CI per environment.
# Hub SDK — snippet values from Hub Admin → Applications → AASTAR → SDK (each environment has its own key).
# Leave empty to build without the SDK tag.
VITE_HUB_SDK_URL=https://dwshub.kpndomain.com/api/sdk/v1/hub-sdk.js
VITE_HUB_SDK_KEY=
# Set by CI: VITE_GIT_SHA=$(git rev-parse --short HEAD) npm run build
VITE_GIT_SHA=
