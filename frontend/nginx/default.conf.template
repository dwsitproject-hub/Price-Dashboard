# Nginx for the frontend container: serves the SPA and reverse-proxies /api to the backend.
# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template):
#   API_UPSTREAM  host:port of the API — `api:8000` in the local stack, `172.28.92.57:4170` on staging
#   HUB_ORIGIN    browser origin of the DWS Hub, allowed in the CSP (security-headers.inc)
#   TRUSTED_PROXY_CIDR, TRUSTED_HOST_IP  the only addresses whose X-Forwarded-For is believed: a host nginx in
#                 front (a vhost for a domain name). Default 127.0.0.1 = no proxy trusted, the visitor connects
#                 directly. Production: the app's Docker subnet and the FE server's own address.
# Plain HTTP: TLS, where there is any, terminates in front of this container. Host-installed variant for
# production: deploy/nginx/aastar.conf
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;   # re-included per location (add_header does not inherit)

    # The visitor's address. Reached directly, $remote_addr already is the visitor. Reached through the host
    # nginx (vhost), the connection comes from that host - its own address, or the Docker network's gateway - and
    # only then is the last X-Forwarded-For entry (the address the host nginx saw) taken instead. Anyone else's
    # X-Forwarded-For is ignored, so the audit log and the sign-in rate limit cannot be fooled.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    set_real_ip_from ${TRUSTED_HOST_IP};
    real_ip_header X-Forwarded-For;

    location = /healthz { access_log off; add_header Content-Type text/plain; return 200 "ok\n"; }

    location /api/ {
        client_max_body_size 32m;   # document / SND uploads; the API enforces per-route limits
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }
    location ~* \.map$ { deny all; }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri /index.html;
    }
}
